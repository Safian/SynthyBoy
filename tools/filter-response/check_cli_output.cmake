# Runs synthyboy_filter_response and checks every line of its output: the comment line, then exactly POINTS lines "frequency,gain" with finite numbers,
# the first frequency 20 Hz, the last 20000 Hz, frequencies rising. Usage: cmake -DTOOL=... -DPRESET=... -DPOINTS=64 -P check_cli_output.cmake
execute_process(COMMAND "${TOOL}" "${PRESET}" --points ${POINTS} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "exit code ${rc}: ${err}")
endif()
string(REPLACE "\n" ";" lines "${out}")
list(LENGTH lines n)
list(GET lines 0 header)
if(NOT header MATCHES "^# ")
    message(FATAL_ERROR "no comment line: ${header}")
endif()
set(count 0)
set(prev 0)
foreach(line IN LISTS lines)
    if(line STREQUAL "" OR line MATCHES "^#")
        continue()
    endif()
    if(NOT line MATCHES "^([0-9]+\\.[0-9]+),(-?[0-9]+\\.[0-9]+)$")
        message(FATAL_ERROR "bad line ${count}: '${line}'")
    endif()
    set(f ${CMAKE_MATCH_1})
    if(count EQUAL 0 AND NOT f STREQUAL "20.00")
        message(FATAL_ERROR "first frequency ${f}")
    endif()
    if(count GREATER 0 AND NOT f GREATER prev)
        message(FATAL_ERROR "frequencies do not rise at line ${count}: ${prev} -> ${f}")
    endif()
    set(prev ${f})
    math(EXPR count "${count} + 1")
endforeach()
if(NOT count EQUAL ${POINTS})
    message(FATAL_ERROR "${count} lines, expected ${POINTS}")
endif()
if(NOT prev STREQUAL "20000.00")
    message(FATAL_ERROR "last frequency ${prev}")
endif()
