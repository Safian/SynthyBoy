#!/usr/bin/env python3
"""Validate the staged screenshot library. The catalogue HTML files are hand-maintained: nothing is generated here."""
import os
from pathlib import Path
import subprocess
import sys


def git(*args, **kwargs):
    return subprocess.check_output(['git', *args], **kwargs)


root = Path(git('rev-parse', '--show-toplevel').decode().strip())
os.chdir(root)
# Validate the actual staged script and index, not another worktree's files.
validator = 'scripts/validate-screen-images.py'
if git('ls-files', '--', validator).strip():
    subprocess.run([sys.executable, '-c', git('show', ':' + validator).decode()], check=True)
