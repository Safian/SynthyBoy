# SynthyBoy - bitmap GUI: turns the font files into a C++ source (EmbeddedFonts.h / EmbeddedFonts.cpp, namespace synthyboy_embedded_fonts) at configure time, without any helper tool.
# Usage: cmake -DOUT_DIR=<dir> -DFILES="a.ttf;b.ttf" -P embed_fonts.cmake
# Names: the file name without non-alphanumeric characters, the extension joined with "_": Roboto-Regular.ttf -> RobotoRegular_ttf, RobotoRegular_ttfSize (what juce_add_binary_data makes).
# Copyright (C) 2026 Safian Szabolcs
# SPDX-License-Identifier: AGPL-3.0-or-later

set(header "// Generated by embed_fonts.cmake. Do not edit.\n#pragma once\n\nnamespace synthyboy_embedded_fonts\n{\n")
set(source "// Generated by embed_fonts.cmake. Do not edit.\n#include \"EmbeddedFonts.h\"\n\nnamespace synthyboy_embedded_fonts\n{\n")
foreach(file ${FILES})
    get_filename_component(stem "${file}" NAME_WE)
    get_filename_component(ext "${file}" EXT)
    string(REGEX REPLACE "[^A-Za-z0-9]" "" stem "${stem}")
    string(REGEX REPLACE "[^A-Za-z0-9]" "" ext "${ext}")
    set(name "${stem}_${ext}")
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" hexLength)
    math(EXPR size "${hexLength} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],)" "\\1\n" bytes "${bytes}")
    string(APPEND header "    extern const unsigned char ${name}[];\n    extern const int ${name}Size;\n")
    string(APPEND source "alignas (4) const unsigned char ${name}[] = {\n${bytes}\n};\nconst int ${name}Size = ${size};\n\n")
endforeach()
string(APPEND header "}\n")
string(APPEND source "}\n")
file(WRITE "${OUT_DIR}/EmbeddedFonts.h" "${header}")
file(WRITE "${OUT_DIR}/EmbeddedFonts.cpp" "${source}")
