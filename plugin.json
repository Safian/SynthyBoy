{
  "schemaVersion": 1,
  "id": "com.safian.synthyboy",
  "name": "SynthyBoy",
  "version": "0.1.0",
  "kind": "instrument",
  "author": "Safian Szabolcs",
  "description": "Wavetable synthesizer (CLAP and VST3) with an engine derived from Vital.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Safian/SynthyBoy",
  "clap_id": "com.safian.synthyboy",
  "builds": {
    "linux-armv7":     { "status": "unbuilt", "url": "", "sha256": "", "size": 0 },
    "linux-aarch64":   { "status": "unbuilt", "url": "", "sha256": "", "size": 0 },
    "linux-x86_64":    { "status": "unbuilt", "url": "", "sha256": "", "size": 0 },
    "macos-universal": { "status": "unbuilt", "url": "", "sha256": "", "size": 0 },
    "windows-x64":     { "status": "unbuilt", "url": "", "sha256": "", "size": 0 }
  },
  "static": {
    "entry": "synthyboy_clap_get_entry",
    "ios":     { "status": "planned", "library": "libsynthyboy_static.a" },
    "android": { "status": "planned", "library": "libsynthyboy_static.a" }
  },
  "gui": {
    "kind": "bitmap",
    "extension": "com.safian.bitmap-gui/1",
    "host_extension": "com.safian.bitmap-gui.host/1",
    "pixel_format": "bgra8888-premul",
    "preferred_width": 1024,
    "preferred_height": 768,
    "min_width": 360,
    "min_height": 480,
    "max_width": 1800,
    "max_height": 1400,
    "builds": ["linux-armv7", "linux-aarch64", "linux-x86_64", "macos-universal", "windows-x64"]
  },
  "contentPacks": [
    {
      "id": "com.safian.synthyboy.factory-presets",
      "name": "Factory Presets",
      "version": "1.2.0",
      "kind": "presets",
      "license": "CC0-1.0",
      "required": false,
      "recommended": true,
      "path": "content/presets",
      "status": "unbuilt",
      "url": "",
      "sha256": "",
      "size": 0
    }
  ]
}
