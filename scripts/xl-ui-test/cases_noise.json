[
  {
    "id": "oscnoise.enabled.keytrack",
    "view": "oscnoise",
    "steps": [
      {
        "op": "snapshot",
        "name": "baseline"
      },
      {
        "op": "expect",
        "target": "noise.on",
        "value": 0
      },
      {
        "op": "tap",
        "control": "oscnoise/Osc Native Surface/Osc Native Power/Osc Native Noise Power"
      },
      {
        "op": "expect",
        "target": "noise.on",
        "change": "only"
      },
      {
        "op": "expect",
        "target": "noise.type",
        "value": 0
      },
      {
        "op": "snapshot",
        "name": "powered"
      },
      {
        "op": "tap",
        "control": "oscnoise/Osc Native Surface/Osc Native Settings/noise.keytrack"
      },
      {
        "op": "expect",
        "target": "noise.keytrack",
        "change": "only",
        "from": "powered"
      }
    ],
    "restore": [
      {
        "op": "tap",
        "control": "oscnoise/Osc Native Surface/Osc Native Settings/noise.keytrack",
        "if_changed": {
          "from": "baseline",
          "target": "noise.keytrack"
        }
      },
      {
        "op": "tap",
        "control": "oscnoise/Osc Native Surface/Osc Native Power/Osc Native Noise Power",
        "if_changed": {
          "from": "baseline",
          "target": "noise.on"
        }
      },
      {
        "op": "expect",
        "target": "*",
        "change": "restored",
        "from": "baseline"
      }
    ]
  },
