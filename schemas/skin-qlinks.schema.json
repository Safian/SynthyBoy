{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "MPC scripted UI: Q-Links.json (SynthyBoy skin)",
 "description": "Q-Link maps. Values are 0-based plugin parameter indices or -1; the range against the plugin parameter count and the tab/sub-tab match with TUI.json are checked in scripts/validate_synthyboy_skin.py.",
