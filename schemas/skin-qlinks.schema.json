        "$ref": "#/definitions/qlinks"
       }
      },
      "required": [
       "Tab",
       "SubTab",
       "Bank Direction",
       "Q-Links"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "version",
    "map"
   ],
   "additionalProperties": false
  },
  "Program Mode Q-Links": {
