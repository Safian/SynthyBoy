    }
   },
   "required": [
    "version",
    "focussed",
    "unfocussed"
   ],
   "additionalProperties": false
  },
  "overlayAction": {
   "type": "object",
   "properties": {
    "version": {
     "const": 1
    },
    "onAction": {
