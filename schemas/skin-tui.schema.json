    },
    "handleName": {
     "const": "Focus Lost"
    },
    "additionalData": {
     "const": ""
    }
   },
   "required": [
    "version",
    "onAction",
    "handler",
    "handleName",
    "additionalData"
   ],
   "additionalProperties": false
  },
  "action": {
   "type": "object",
   "properties": {
    "version": {
     "const": 1
    },
    "onAction": {
     "enum": [
      "Mouse Down",
      "Double Click",
      "Enter Pressed"
     ]
    },
    "handler": {
     "enum": [
      "Show Overlay",
      "Toggle Switch",
      "Q-Link"
     ]
    },
    "handleName": {
     "$ref": "#/definitions/handle"
    },
    "additionalData": {
     "type": "string"
    }
   },
   "required": [
    "version",
    "onAction",
    "handler",
    "handleName",
    "additionalData"
   ],
   "additionalProperties": false
  },
  "textStyle": {
   "type": "object",
   "properties": {
    "version": {
     "const": 1
    },
    "font": {
     "type": "object",
     "properties": {
      "version": {
       "const": 1
      },
      "name": {
       "enum": [
        "Titillium Web",
        "Roboto",
        "Nexa"
       ]
      },
      "style": {
       "enum": [
        "Regular",
        "SemiBold",
        "Bold",
        "Light",
        "Medium"
       ]
      },
      "height": {
       "type": "number"
      }
     },
     "required": [
      "version",
      "name",
      "style",
      "height"
     ],
     "additionalProperties": false
    },
    "colour": {
     "$ref": "#/definitions/colour"
    },
    "justification": {
     "type": "string",
     "pattern": "^(?:left|right|horizontallyCentred|top|bottom|verticallyCentred|horizontallyJustified|leftJustified)(?: (?:left|right|horizontallyCentred|top|bottom|verticallyCentred|horizontallyJustified|leftJustified))*$"
    },
    "case": {
     "enum": [
      "Original",
      "Upper Case",
      "Lower Case"
     ]
    }
   },
   "required": [
    "version",
    "font",
    "colour",
    "justification",
    "case"
   ],
   "additionalProperties": false
  },
  "dataLabel": {
   "type": "object",
   "properties": {
    "version": {
     "const": 1
    },
    "textStyle": {
     "$ref": "#/definitions/textStyle"
    },
    "type": {
     "enum": [
