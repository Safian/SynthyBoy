       "colour",
       "image"
      ],
      "properties": {
       "version": {
        "const": 2
       },
       "imageType": {
        "enum": [
         "Regular",
         "FilmStrip"
        ]
       },
       "colour": {
        "$ref": "#/definitions/colour"
       },
       "image": {
        "$ref": "#/definitions/imagePath"
       },
       "numFrames": {
        "type": "integer",
        "minimum": 1
       },
       "handleName": {
        "$ref": "#/definitions/handle"
       },
       "animated": {
        "type": "boolean"
       }
      },
      "additionalProperties": false,
      "allOf": [
       {
        "if": {
         "properties": {
          "imageType": {
           "const": "FilmStrip"
          }
         }
        },
        "then": {
         "required": [
          "numFrames",
          "handleName"
         ]
        },
        "else": {
         "not": {
          "anyOf": [
           {
            "required": [
             "numFrames"
            ]
           },
           {
            "required": [
             "handleName"
            ]
           },
           {
            "required": [
             "animated"
            ]
           }
          ]
         }
        }
       }
      ]
     }
    }
   ]
  },
  "dataButton": {
   "type": "object",
