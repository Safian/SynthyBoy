{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "MPC scripted UI: TUI.json (SynthyBoy skin)",
 "description": "Shapes proven by the skin that runs on both devices (git 1fd0d592:skin/TUI.json) and by the SDK docs/ui-reference.md. Validate a copy with the duplicate 'version' keys of overlay widget data removed (scripts/validate_synthyboy_skin.py does this). Rules marked x-unproven are accepted but warned about. New host findings are added here as rules.",
 "x-unproven-handle-pattern": "^(?:(?:FromGesture/|NonZero/|IndexedEnabling/\\d+/\\d+/|RangedEnabling/\\d+/\\d+/\\d+/|WithName\\[[^\\]]*\\]/)|(?:Hold/|Invert/|AsDB/|AsDBFromGain/|DisableCoarseIncrement/|FilterEmptyStrings/|ResetOnGestureEnd/|TabLimited/\\d+/\\d+/\\d+/|WithPrefix\\[[^\\]]*\\]/|WithSuffix\\[[^\\]]*\\]/|AffineMap\\[[^\\]]*\\]/|DisplayValue\\[[^\\]]*\\]/))*(?:(?:Parameter \\{Increment:Base=\\d+(?:,Step=-?\\d+)?(?:,Offset=-?\\d+)?\\}|Local/\\d+/[A-Za-z_][A-Za-z0-9_]*|[^/\\[\\]{}]*)|(?:PageIndex \\d+, \\d+(?:, \\d+)?|Parameter/Named/[^/]+))$",
 "x-proven-handle-pattern": "^(?:FromGesture/|NonZero/|IndexedEnabling/\\d+/\\d+/|RangedEnabling/\\d+/\\d+/\\d+/|WithName\\[[^\\]]*\\]/)*(?:Parameter \\{Increment:Base=\\d+(?:,Step=-?\\d+)?(?:,Offset=-?\\d+)?\\}|Local/\\d+/[A-Za-z_][A-Za-z0-9_]*|[^/\\[\\]{}]*)$",
 "x-unproven-component-types": [
  "Separator",
  "ComboBox",
  "KnobOverlay",
  "TextEditOverlay",
  "Envelope",
  "EnvelopeOverlay",
  "XYPad",
  "Plotter",
  "HaloDisplay",
  "Indicator",
  "Path",
  "GuiButton",
  "GuiComboBox",
  "GuiKnob",
  "EditNumberSlider",
  "Decorator"
 ],
 "x-proven-component-types": [
  "Label",
  "Image",
  "Button",
  "Knob",
  "Meter",
  "Focus",
  "MenuOverlay",
  "NumericOverlay",
  "Slider"
 ],
 "type": "object",
 "required": [
  "pageData"
 ],
 "additionalProperties": false,
 "properties": {
  "pageData": {
   "type": "object",
   "properties": {
    "version": {
     "const": 1
    },
    "componentDefinitions": {
     "type": "object",
     "properties": {
      "version": {
       "const": 2
      },
      "importFiles": {
       "type": "array",
       "maxItems": 0
      },
      "localComponentDefinitions": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "key": {
          "type": "string",
          "minLength": 1
         },
         "value": {
          "$ref": "#/definitions/componentDefinition"
         }
        },
        "required": [
         "key",
         "value"
        ],
        "additionalProperties": false
       }
      }
     },
     "required": [
      "version",
      "importFiles",
      "localComponentDefinitions"
     ],
     "additionalProperties": false
    },
    "replacementStrings": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "key": {
        "type": "string",
        "pattern": "^Parameter \\d+$"
       },
       "value": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "string"
        }
       }
      },
      "required": [
       "key",
       "value"
      ],
      "additionalProperties": false
     }
    },
    "info": {
     "$ref": "#/definitions/info"
    },
    "tabs": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/definitions/tab"
     }
    }
   },
   "required": [
    "version",
    "componentDefinitions",
    "replacementStrings",
    "info",
    "tabs"
   ],
   "additionalProperties": false
  }
 },
 "definitions": {
  "handle": {
   "type": "string",
   "pattern": "^(?:(?:FromGesture/|NonZero/|IndexedEnabling/\\d+/\\d+/|RangedEnabling/\\d+/\\d+/\\d+/|WithName\\[[^\\]]*\\]/)|(?:Hold/|Invert/|AsDB/|AsDBFromGain/|DisableCoarseIncrement/|FilterEmptyStrings/|ResetOnGestureEnd/|TabLimited/\\d+/\\d+/\\d+/|WithPrefix\\[[^\\]]*\\]/|WithSuffix\\[[^\\]]*\\]/|AffineMap\\[[^\\]]*\\]/|DisplayValue\\[[^\\]]*\\]/))*(?:(?:Parameter \\{Increment:Base=\\d+(?:,Step=-?\\d+)?(?:,Offset=-?\\d+)?\\}|Local/\\d+/[A-Za-z_][A-Za-z0-9_]*|[^/\\[\\]{}]*)|(?:PageIndex \\d+, \\d+(?:, \\d+)?|Parameter/Named/[^/]+))$",
   "description": "A handle string. Grammar: zero or more modifier prefixes, then a base (Parameter N, Parameter {Increment:...}, Local/range/id, Invalid, or a scoped name resolved through handle remapping). Anything with a '/' that is not a known modifier fails here."
  },
  "colour": {
   "type": "string",
   "pattern": "^(?:0|[0-9a-fA-F]{8})?$",
   "description": "AARRGGBB, or '0' / '' for transparent"
  },
  "imagePath": {
   "type": "string",
   "pattern": "^(?:[^/\\\\]+\\.png)?$",
   "description": "empty, or a PNG next to the JSON file"
  },
  "rect": {
   "type": "string",
   "pattern": "^-?\\d+(?:\\.\\d+)? -?\\d+(?:\\.\\d+)? -?\\d+(?:\\.\\d+)? -?\\d+(?:\\.\\d+)?$",
   "description": "'x y w h': four numbers separated by single spaces"
  },
  "info": {
   "type": "object",
   "properties": {
    "version": {
     "const": 1
    },
    "type": {
     "const": "CompleteDescription"
    }
   },
   "required": [
    "version",
    "type"
   ],
   "additionalProperties": false
  },
  "imageData": {
   "type": "object",
   "properties": {
    "version": {
     "const": 1
    },
    "colour": {
     "$ref": "#/definitions/colour"
    },
    "image": {
     "$ref": "#/definitions/imagePath"
    }
   },
   "required": [
