{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynthyBoy plugin manifest (plugin.json)",
  "description": "Describes the plugin for the host-side PluginManifest, see docs/ARCHITECTURE.md section 7. builds[*] and contentPacks[*] url/sha256/size are filled in by the release job (scripts/fill-manifest.py, docs/RELEASE.md); entries that are not built yet have status 'unbuilt' and empty placeholders. The optional author, description, assets, key_id and signature are the fields the Kick plugin manager reads besides the ones above.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "kind", "license", "clap_id", "builds", "static", "contentPacks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "kind": { "type": "string", "enum": ["instrument", "effect"] },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+$" },
    "homepage": { "type": "string", "pattern": "^https://" },
    "min_host_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "clap_id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "builds": {
      "type": "object",
      "required": ["linux-armv7", "linux-aarch64", "linux-x86_64", "macos-universal", "windows-x64"],
      "additionalProperties": false,
      "properties": {
        "linux-armv7": { "$ref": "#/$defs/build" },
        "linux-aarch64": { "$ref": "#/$defs/build" },
        "linux-x86_64": { "$ref": "#/$defs/build" },
        "macos-universal": { "$ref": "#/$defs/build" },
        "windows-x64": { "$ref": "#/$defs/build" }
      }
    },
    "static": {
      "type": "object",
      "required": ["entry", "ios", "android"],
      "additionalProperties": false,
      "properties": {
        "entry": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "ios": { "$ref": "#/$defs/staticBuild" },
        "android": { "$ref": "#/$defs/staticBuild" }
      }
    },
    "gui": { "$ref": "#/$defs/gui" },
    "contentPacks": { "type": "array", "items": { "$ref": "#/$defs/contentPack" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "key_id": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "pattern": "^([0-9a-f]{128})?$" }
  },
  "$defs": {
    "build": {
      "type": "object",
      "required": ["status", "url", "sha256", "size"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["unbuilt", "released"] },
        "url": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
        "size": { "type": "integer", "minimum": 0 },
        "entry_point": { "type": "string", "minLength": 1 }
      }
    },
    "contentPack": {
      "type": "object",
      "required": ["id", "name", "version", "kind", "license", "required", "recommended", "path", "status", "url", "sha256", "size"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "kind": { "type": "string", "enum": ["presets", "wavetables", "samples"] },
        "license": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+$" },
        "required": { "type": "boolean" },
        "recommended": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["unbuilt", "released"] },
        "url": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "name", "version", "url", "sha256", "size", "required", "type", "license"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "url": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "required": { "type": "boolean" },
        "type": { "type": "string", "enum": ["presets", "wavetables", "samples"] },
        "license": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+$" }
      }
    },
    "gui": {
      "description": "The GUI the module itself offers to a host that cannot run the plug-in's toolkit: kind 'bitmap' = the CLAP extension in 'extension' (docs/BITMAP-GUI-EXTENSION.md), the plug-in renders into a pixel buffer. 'builds' names the builds above that contain it (the static iOS / Android library does not).",
      "type": "object",
      "required": ["kind", "extension", "builds"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["bitmap"] },
        "extension": { "type": "string", "pattern": "^[a-z0-9.-]+/[0-9]+$" },
        "host_extension": { "type": "string", "pattern": "^[a-z0-9.-]+/[0-9]+$" },
        "pixel_format": { "type": "string", "enum": ["bgra8888-premul"] },
        "preferred_width": { "type": "integer", "minimum": 1 },
        "preferred_height": { "type": "integer", "minimum": 1 },
        "min_width": { "type": "integer", "minimum": 1 },
        "min_height": { "type": "integer", "minimum": 1 },
        "max_width": { "type": "integer", "minimum": 1 },
        "max_height": { "type": "integer", "minimum": 1 },
        "builds": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["linux-armv7", "linux-aarch64", "linux-x86_64", "macos-universal", "windows-x64"] } }
      }
    },
    "staticBuild": {
      "type": "object",
      "required": ["status", "library"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["planned", "available"] },
        "library": { "type": "string", "minLength": 1 }
      }
    }
  }
}
