{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynthyBoy content pack manifest (contentpack.json)",
  "description": "Describes a ContentPack for SynthyBoy, see docs/ARCHITECTURE.md section 6.",
  "type": "object",
  "required": ["id", "version", "schemaVersion", "license", "attribution", "kind", "requires_plugin", "files"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+$" },
    "attribution": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["presets", "wavetables", "samples"] },
    "requires_plugin": { "type": "string", "pattern": "^(>=)?[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "size": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
